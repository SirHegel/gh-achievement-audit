{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SirHegel/gh-achievement-audit/v0.1.0/schema/report-v1.schema.json",
  "title": "gh-achievement-audit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "subject",
    "complete",
    "scope",
    "visible_achievements",
    "achievement_endpoints",
    "public_evidence",
    "program_signals",
    "source_health",
    "sources",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "complete": { "const": true },
    "scope": { "$ref": "#/$defs/scope" },
    "visible_achievements": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/visibleAchievement" }
    },
    "achievement_endpoints": {
      "type": "array",
      "minItems": 11,
      "maxItems": 43,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/achievementEndpoint" }
    },
    "public_evidence": { "$ref": "#/$defs/publicEvidence" },
    "program_signals": { "$ref": "#/$defs/programSignals" },
    "source_health": { "$ref": "#/$defs/sourceHealth" },
    "sources": { "$ref": "#/$defs/sources" },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "$defs": {
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "githubUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "url"],
      "properties": {
        "login": { "$ref": "#/$defs/login" },
        "url": { "$ref": "#/$defs/githubUrl" }
      }
    },
    "visibleAchievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": { "$ref": "#/$defs/githubUrl" }
      }
    },
    "achievementEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "status", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": { "enum": [200, 404] },
        "url": { "$ref": "#/$defs/githubUrl" }
      }
    },
    "pullRequestCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_total",
        "outside_personal_namespace_total",
        "self_merged_total"
      ],
      "properties": {
        "public_total": { "type": "integer", "minimum": 0 },
        "outside_personal_namespace_total": { "type": "integer", "minimum": 0 },
        "self_merged_total": { "type": "integer", "minimum": 0 }
      }
    },
    "answerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "repository",
        "owned_by_subject",
        "self_accepted",
        "created_at",
        "upvotes"
      ],
      "properties": {
        "url": { "$ref": "#/$defs/githubUrl" },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "maxLength": 201
        },
        "owned_by_subject": { "type": "boolean" },
        "self_accepted": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "upvotes": { "type": "integer", "minimum": 0 }
      }
    },
    "acceptedAnswers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_total",
        "outside_personal_namespace_total",
        "self_accepted_total",
        "evidence"
      ],
      "properties": {
        "public_total": { "type": "integer", "minimum": 0 },
        "outside_personal_namespace_total": { "type": "integer", "minimum": 0 },
        "self_accepted_total": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/answerEvidence" }
        }
      }
    },
    "repositoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_with_owner", "url", "stars", "forks"],
      "properties": {
        "name_with_owner": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "maxLength": 201
        },
        "url": { "$ref": "#/$defs/githubUrl" },
        "stars": { "type": "integer", "minimum": 0 },
        "forks": { "type": "integer", "minimum": 0 }
      }
    },
    "ownedRepositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "total_stars", "top_by_stars"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "total_stars": { "type": "integer", "minimum": 0 },
        "top_by_stars": {
          "oneOf": [
            { "$ref": "#/$defs/repositoryEvidence" },
            { "type": "null" }
          ]
        }
      }
    },
    "publicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merged_pull_requests",
        "accepted_discussion_answers",
        "owned_public_nonfork_repositories",
        "advisory_database"
      ],
      "properties": {
        "merged_pull_requests": { "$ref": "#/$defs/pullRequestCounts" },
        "accepted_discussion_answers": { "$ref": "#/$defs/acceptedAnswers" },
        "owned_public_nonfork_repositories": { "$ref": "#/$defs/ownedRepositories" },
        "advisory_database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merged_contributions"],
          "properties": {
            "merged_contributions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "programSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "developer_program_member",
        "security_bug_bounty_hunter",
        "campus_expert",
        "github_star"
      ],
      "properties": {
        "developer_program_member": { "type": "boolean" },
        "security_bug_bounty_hunter": { "type": "boolean" },
        "campus_expert": { "type": "boolean" },
        "github_star": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "anti_farming",
        "predicts_unlocks",
        "outside_personal_namespace_definition"
      ],
      "properties": {
        "visibility": { "const": "PUBLIC_ONLY" },
        "anti_farming": { "const": true },
        "predicts_unlocks": { "const": false },
        "outside_personal_namespace_definition": {
          "const": "REPOSITORY_OWNER_DIFFERS_FROM_SUBJECT_LOGIN"
        }
      }
    },
    "sourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphql", "profile"],
      "properties": {
        "graphql": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete"],
          "properties": {
            "complete": { "const": true }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "url"],
          "properties": {
            "complete": { "const": true },
            "url": { "$ref": "#/$defs/githubUrl" }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_profile_reference",
        "official_discussions_graphql_reference",
        "official_gh_api_pagination_reference"
      ],
      "properties": {
        "official_profile_reference": {
          "const": "https://docs.github.com/en/account-and-profile/reference/profile-reference"
        },
        "official_discussions_graphql_reference": {
          "const": "https://docs.github.com/en/graphql/reference/discussions"
        },
        "official_gh_api_pagination_reference": {
          "const": "https://cli.github.com/manual/gh_api"
        }
      }
    }
  }
}
